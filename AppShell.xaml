<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Ubuntu_Intelli_Compass.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Ubuntu_Intelli_Compass.Views"
    xmlns:local="clr-namespace:Ubuntu_Intelli_Compass"
    Title="Ubuntu_Intelli_Compass">

    <ShellContent
        Title="PreLoad"
        ContentTemplate="{DataTemplate views:PreLoadPage}"
        Route="PreloadPage" />

   

    <ShellContent
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
